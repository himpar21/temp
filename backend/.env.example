APP_NAME=AI Test Management Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
RAG_RELEVANCE_THRESHOLD=0.85
RAG_VANILLA_FALLBACK_THRESHOLD=0.30
GRAPH_RAG_MAX_PATHS=2000
GRAPH_RAG_MAX_EXPANSIONS=10000
GRAPH_RAG_TIME_BUDGET_SECONDS=2.0

# ── PostgreSQL — structured relational data ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_test_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_COOKIE_NAME=access_token

# ── Ollama LLM (local — no API key required) ──────────────────────────────
# Run: ollama serve
# Models: ollama pull qwen2.5-coder:1.5b && ollama pull nomic-embed-text
# NOTE: docker-compose overrides OLLAMA_BASE_URL to host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MAX_TOKENS=1024
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=120

# ── Qdrant — vector embeddings and semantic search ─────────────────────────
# Run: docker compose up qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=test_management_chunks

# ── Neo4j Community — knowledge graph ─────────────────────────────────────
# Run: docker compose up neo4j
# Browser UI: http://localhost:7474  (user: neo4j / password: password)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
